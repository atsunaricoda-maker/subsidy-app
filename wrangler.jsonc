{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "subsidy-app",
  "compatibility_date": "2025-11-17",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "subsidy-manager-production",
      "database_id": "9cc67ea6-387e-40f3-b7f9-cc376a26bea2"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "subsidy-app-documents"
    }
  ],
  "vars": {
    "GEMINI_API_KEY": "",
    "CRON_SECRET": ""
  },
  // Cron Triggers for scheduled guideline monitoring
  // Note: Cron triggers are configured in Cloudflare Dashboard for Pages
  // For Workers, use the following format:
  // "triggers": {
  //   "crons": [
  //     "0 9 * * *",    // Daily at 9:00 AM JST (0:00 UTC)
  //     "0 9 1 * *"     // Monthly on 1st at 9:00 AM JST
  //   ]
  // }
}