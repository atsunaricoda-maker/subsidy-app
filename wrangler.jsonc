{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "subsidy-app",
  "compatibility_date": "2025-11-17",
  "pages_build_output_dir": "./dist",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "subsidy-app-production",
      "database_id": "9cc67ea6-387e-40f3-b7f9-cc376a26bea2"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "subsidy-app-documents"
    }
  ]
}